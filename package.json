{
  "name": "opina",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild"
  ],
  "scripts": {
    "dev": "bun run --filter @opina/server dev",
    "demo": "bun run --filter @opina/demo dev",
    "build": "bun run --filter @opina/widget build && bun run --filter @opina/server build",
    "build:widget": "bun run --filter @opina/widget build",
    "build:server": "bun run --filter @opina/server build",
    "db:generate": "bun run --filter @opina/server db:generate",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "volta": {
    "node": "22.22.2",
    "bun": "1.3.14"
  },
  "engines": {
    "node": "22.x",
    "bun": ">=1.2"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
