NUXT_PUBLIC_URL=http://localhost:3000
# Production: random string, 32+ chars. Example value is rejected when NODE_ENV=production
# unless OPINA_ALLOW_INSECURE=1 (local docker compose sets that).
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret!!
OPINA_PORT=3000
# Local pnpm dev (relative to apps/server). Docker compose overrides to /data.
OPINA_DATA_DIR=../../data
# Optional fixed first-install token (otherwise a random 30-minute token is printed in logs)
# OPINA_SETUP_TOKEN=
# OPINA_ALLOW_INSECURE=1

# Optional S3/R2 backups
# OPINA_BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OPINA_BACKUP_S3_BUCKET=opina-backups
# OPINA_BACKUP_S3_ACCESS_KEY_ID=
# OPINA_BACKUP_S3_SECRET_ACCESS_KEY=
# OPINA_BACKUP_S3_REGION=auto
# OPINA_BACKUP_PREFIX=opina/
# OPINA_BACKUP_CRON=0 */6 * * *
# OPINA_BACKUP_RETENTION=28
# OPINA_RATE_LIMIT_PER_MIN=30
# OPINA_LOGIN_RATE_LIMIT_PER_MIN=10
# OPINA_MAX_RESPONSES_PER_VISITOR_DAY=10
# OPINA_TRUST_PROXY=true
